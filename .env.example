# Copy to .env.local and fill in. Every integration falls back gracefully when unset.

# Public site URL used for canonical links, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://wackys.com

# Party enquiry delivery. POSTs JSON to this webhook (Zapier/Make/your CRM).
# Unset -> the form tells guests to call the location and offers a prefilled email.
PARTY_ENQUIRY_WEBHOOK_URL=

# Contact form delivery (same behaviour as above).
CONTACT_WEBHOOK_URL=

# VIP Club signup. POSTs JSON to the authorised email-marketing endpoint.
# Unset -> signup sends guests to the official VIP page instead.
VIP_SIGNUP_WEBHOOK_URL=
# Shared secret sent as the X-Wackys-Signature header to the webhooks above.
WEBHOOK_SHARED_SECRET=

# ── Static hosting (GitHub Pages) ──────────────────────────────
# `npm run build:pages` writes plain files to ./out. API routes are not available there,
# so forms post straight from the browser to these public endpoints (e.g. Formspree).
# Unset -> forms show the phone / email fallback.
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_PARTY_FORM_URL=
NEXT_PUBLIC_CONTACT_FORM_URL=
NEXT_PUBLIC_VIP_FORM_URL=
